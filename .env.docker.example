# Copy to .env.docker.local. MYSQL_PASSWORD must be URL-safe (letters/numbers).
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
VITE_API_BASE_URL=/api
FRONTEND_ORIGIN=http://localhost:4000

# Existing deployed AI base URL, without /api/chat.
OLLAMA_BASE_URL=https://YOUR_DEPLOYED_AI_HOST
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_API_KEY=
