# Copy to .env.docker.local and replace database credentials before starting Backend.
# host.docker.internal reaches MySQL on this Windows host from Docker Desktop.
DATABASE_URL='mysql://USER:PASSWORD@host.docker.internal:3306/DATABASE'

# Browser-visible URLs: use real HTTPS domains for remote deployment.
VITE_API_BASE_URL=http://localhost:4001/api
FRONTEND_ORIGIN=http://localhost:4000

# Docker service name works only when Backend and Ollama share this Compose network.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_API_KEY=
