DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
PORT=4001
# Allowed frontend origins, separated by commas (no trailing slash).
FRONTEND_ORIGIN="http://localhost:4000"

# Backend-only settings. Use the AI server's private URL when deployed separately.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:4b"
OLLAMA_TIMEOUT_MS=120000
# Optional bearer token for an authenticated reverse proxy in front of Ollama.
OLLAMA_API_KEY=""
